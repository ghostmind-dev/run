{
  "id": "ic9ETB7juz3g",
  "type": "project",
  "name": "run",
  "routines": {
    "check": "deno check run/bin/cmd.ts",
    "test": "deno test  --allow-all run/test/units.ts",
    "herdr_init": "run herdr init run",
    "herdr_attach": "run herdr attach run",
    "herdr_terminate": "run herdr terminate run",
    "install": "deno install -A -f -g -n run run/bin/cmd.ts",
    "echo": "echo ${SRC}"
  },
  "herdr": {
    "workspaces": [
      {
        "label": "run",
        "color": "blue",
        "tabs": [
          {
            "label": "single",
            "prefix": false,
            "layout": "compact",
            "compact": {
              "type": "single",
              "panes": ["main"]
            }
          },
          {
            "label": "quad",
            "prefix": false,
            "layout": "compact",
            "compact": {
              "type": "two-by-two",
              "panes": ["top-left", "top-right", "bottom-left", "bottom-right"]
            }
          },
          {
            "label": "split",
            "prefix": false,
            "layout": "compact",
            "compact": {
              "type": "vertical",
              "panes": ["left", "right"]
            }
          }
        ]
      }
    ]
  }
}