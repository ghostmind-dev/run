{
  "name": "@ghostmind/run",
  "version": "0.16.2",
  "license": "MIT",
  "description": "A CLI toolkit for Ghostmind projects: a projects dashboard, herdr workspaces, routines, and more",
  "exports": {
    ".": "./run/main.ts",
    "./cmd": "./run/bin/cmd.ts"
  },
  "lint": {
    "include": ["**/run/**", "**/.devcontainer/**"],
    "exclude": ["**/run/test/**"],
    "rules": {
      "tags": ["recommended"],
      "include": ["ban-untagged-todo"],
      "exclude": [
        "no-unused-vars",
        "no-explicit-any",
        "prefer-const",
        "require-await"
      ]
    }
  }
}
